APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://themarketmirror.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend CORS origins (comma-separated or * for dev)
FRONTEND_URL=*
FRONTEND_BUYER_URL=https://themarketmirror.com
FRONTEND_ADMIN_URL=https://themarketmirror.com
FRONTEND_VENDOR_URL=https://themarketmirror.com
RENDER_EXTERNAL_URL=https://themarketmirror.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://themarketmirror.com/auth/google/callback

# Agora credentials. Keep the app certificate server-side.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Flutterwave: keep secret key/hash server-side and never expose them to Vite.
# FLW_SECRET_HASH must match the "Secret hash" set on the Flutterwave dashboard
# webhook settings; it is used to authenticate POST /api/payments/webhook.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_CURRENCY=NGN
FLW_REDIRECT_URL=http://localhost:5173/payment/callback
FLW_DEFAULT_BANK_CODE=

# Bank lookup uses Flutterwave's Nigerian bank list and account-resolution APIs.
# FLW_SECRET_KEY must remain server-side; never expose it through Vite variables.
